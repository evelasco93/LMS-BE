{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "../../dist/handlers/leads",
    "rootDir": "../..",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@shared/*": ["../../shared/*"],
      "@interfaces/*": ["./interfaces/*"],
      "@types/*": ["./types/*"],
      "@enums/*": ["./enums/*"],
      "@services/*": ["./services/*"],
      "@controllers/*": ["./controllers/*"],
      "@modules/*": ["./modules/*"],
      "@constants/*": ["./constants/*"]
    }
  },
  "include": ["**/*.ts", "../../utils/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
